{
  "name": "dsh-context-steady",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin for bounded, provenance-linked context steady state with recoverable raw history",
  "homepage": "https://github.com/slicenferqin/dsh-context-steady#readme",
  "bugs": {
    "url": "https://github.com/slicenferqin/dsh-context-steady/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "sideEffects": false,
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "BENCHMARK.md",
    "bench/*.py",
    "bench/*.mjs",
    "bench/README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check lib/index.js && node --check test/smoke.mjs && node test/smoke.mjs",
    "test:release": "npm test && npm pack --dry-run --json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh-plugin",
    "context",
    "compaction",
    "context-steady",
    "provenance",
    "long-running-agent",
    "memory",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slicenferqin/dsh-context-steady.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
